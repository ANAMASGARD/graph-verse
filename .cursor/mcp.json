{
  "mcpServers": {
    "falkordb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@falkordb/mcpserver@latest"],
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "FALKORDB_DEFAULT_READONLY": "false",
        "FALKORDB_STRICT_READONLY": "false"
      }
    }
  }
}
