{
  "mcpServers": {
    "falkordb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@falkordb/mcpserver@latest"],
      "env": {
        "FALKORDB_HOST": "127.0.0.1",
        "FALKORDB_PORT": "6379",
        "FALKORDB_USERNAME": "",
        "FALKORDB_PASSWORD": "",
        "FALKORDB_DEFAULT_READONLY": "false"
      }
    }
  }
}
