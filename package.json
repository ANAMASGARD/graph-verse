{
  "name": "graph-verse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "parse": "node parser/cli.mts",
    "verify:falkordb": "node --env-file=.env.local scripts/verify-falkordb-connection.mjs",
    "db:apply-schema": "node --env-file=.env.local scripts/apply-graph-schema.mjs --from-env",
    "db:seed": "node --env-file=.env.local scripts/seed-dev-graphs.mjs --from-env",
    "eval:paths": "node --import ./evals/register.mjs evals/paths.mts",
    "eval:roles": "node --import ./evals/register.mjs evals/roles.mts",
    "eval:prompts": "node --import ./evals/register.mjs evals/prompts.mts",
    "eval:agent": "node --import ./evals/register.mjs evals/agent.mts",
    "agent": "NPM_CONFIG_ALLOW_REMOTE=all npm --prefix agent run dev"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.17",
    "@clerk/ui": "^1.40.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "falkordb": "^6.8.0",
    "langsmith": "0.10.5",
    "next": "16.4.2",
    "openai": "7.23.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^14.2.35",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
